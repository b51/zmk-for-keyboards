#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/rgb.h>

#define BASE 0
#define LOWER 1
#define RAISE 2
#define ADJUST 3

/ {
    // Activate ADJUST layer by pressing raise and lower

    conditional_layers { compatible = "zmk,conditional-layers"; };

    behaviors {
        tmt: tap_preferred_mt {
            compatible = "zmk,behavior-hold-tap";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            flavor = "tap-preferred";
            label = "Tap-Prefered-Mod-Tap";
        };
    };

    behaviors {
        hml: home_row_mod_left {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            require-prior-idle-ms = <150>;
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            bindings = <&kp>, <&kp>;

            hold-trigger-key-positions = <25 26 27 28 29>; // List of keys on the right side of the keyboard
            hold-trigger-on-release;
        };

        hmr: home_row_mod_right {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            require-prior-idle-ms = <150>;
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            bindings = <&kp>, <&kp>;

            hold-trigger-key-positions = <30 32 31 33 34>; // List of keys on the left side of the keyboard
            hold-trigger-on-release;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "Base";   // 👈 this is the layer name you see in UI/OLED
            // ------------------------------------------------------------------------------------------------------------
            // |  ESC  |  1  |  2  |  3   |  4   |  5   |                   |  6   |  7    |  8    |  9   |   0   | BKSPC |
            // |  TAB  |  Q  |  W  |  E   |  R   |  T   |                   |  Y   |  U    |  I    |  O   |   P   |   \   |
            // | LCTRL |  A  |  S  |  D   |  F   |  G   |                   |  H   |  J    |  K    |  L   |   ;   |   '   |
            // | SHIFT |  Z  |  X  |  C   |  V   |  B   |  MUTE  |  |       |  N   |  M    |  ,    |  .   |   /   | SHIFT |
            //               | GUI |  -   | ALT  | SPACE|   {    |  |   }   | Enter|  fn   | =     | `    |

            bindings = <
&kp ESC    &kp N1  &kp N2               &kp N3           &kp N4            &kp N5                              &kp N6       &kp N7             &kp N8               &kp N9   &kp N0    &kp BSPC
&kp TAB    &kp Q   &tmt LC(LEFT_GUI) W  &kp E            &kp R             &kp T                               &kp Y        &kp U              &tmt LC(LEFT_ALT) I  &kp O    &kp P     &kp BSLH
&kp LCTRL  &kp A   &kp S                &tmt LEFT_ALT D  &kp F             &kp G                               &kp H        &kp J              &kp K                &kp L    &kp SEMI  &kp SQT
&kp LSHFT  &kp Z   &kp X                &kp C            &kp V             &kp B        &kp C_MUTE    &to 1    &kp N        &kp M              &kp COMMA            &kp DOT  &kp FSLH  &mt RSHFT GRAVE
                   &kp LEFT_GUI         &kp LEFT_ALT     &kp LEFT_BRACKET  &lt 4 MINUS  &kp SPACE     &kp RET  &lt 4 EQUAL  &kp RIGHT_BRACKET  &mo 4                &tog 2
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_DN C_VOL_UP &inc_dec_kp PG_UP PG_DN>;
        };

        raise_layer {
            display-name = "Dota";

            // ------------------------------------------------------------------------------------------------------------
            // |       |        |        |       |       |      |                |        |       |       |      |       |       |
            // |       |        |        |       |       |      |                |        |       |       |      |       |       |
            // |       |        |        |       |       |      |                |        |       |       |      |       |       |
            // |       |        |        |       |       |      |      |  |      |        |       |       |      |       |       |
            //                  |  F6    |  F5   |       |      |  F1  |  |      |        |       |       |      |

            bindings = <
&kp GRAVE  &trans  &trans         &trans  &trans  &trans                    &trans  &trans  &trans  &trans  &trans  &trans
&trans     &trans  &trans         &trans  &trans  &trans                    &trans  &trans  &trans  &trans  &trans  &trans
&trans     &trans  &trans         &trans  &trans  &trans                    &trans  &trans  &trans  &trans  &trans  &trans
&trans     &trans  &trans         &trans  &trans  &trans  &trans    &tog 1  &trans  &trans  &trans  &trans  &trans  &trans
                   &kp BACKSLASH  &trans  &kp F6  &kp F1  &trans    &trans  &trans  &trans  &trans  &tog 1
            >;

            sensor-bindings =
                <&inc_dec_kp F5 F6>,
                <&inc_dec_kp C_VOLUME_DOWN C_VOLUME_UP>;
        };

        adjust_layer {
            display-name = "FPS";
            bindings = <
&kp ESC    &kp N1  &kp N2        &kp N3        &kp N4            &kp N5                                     &kp N6       &kp N7             &kp N8     &kp N9   &kp N0    &kp BSPC
&kp TAB    &kp Q   &kp W         &kp E         &kp R             &kp T                                      &kp Y        &kp U              &kp I      &kp O    &kp P     &kp BSLH
&kp LCTRL  &kp A   &kp S         &kp D         &kp F             &kp G                                      &kp H        &kp J              &kp K      &kp L    &kp SEMI  &kp SQT
&kp LSHFT  &kp Z   &kp X         &kp C         &kp V             &kp B               &kp C_MUTE    &to 1    &kp N        &kp M              &kp COMMA  &kp DOT  &kp FSLH  &kp RSHFT
                   &kp LEFT_GUI  &kp LEFT_ALT  &kp LEFT_BRACKET  &mt LEFT_GUI MINUS  &kp SPACE     &kp RET  &lt 4 EQUAL  &kp RIGHT_BRACKET  &mo 4      &tog 2
            >;

            sensor-bindings =
                <&inc_dec_kp C_VOL_DN C_VOL_UP>,
                <&inc_dec_kp PG_UP PG_DN>;
        };

        mid_layer {
            display-name = "Move";
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans                    &trans    &trans    &trans  &trans     &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                    &trans    &trans    &trans  &trans     &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                    &kp LEFT  &kp DOWN  &kp UP  &kp RIGHT  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans    &trans    &trans  &trans     &trans  &trans
                &trans  &trans  &trans  &trans  &trans    &trans  &trans    &trans    &mo 4   &to 0
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_DN C_VOL_UP &inc_dec_kp PG_UP PG_DN>;
        };

        lower_layer {
            display-name = "Func";
            bindings = <
&trans           &kp F1    &kp F2    &kp F3           &kp F4           &kp F5                                     &kp F6           &kp F7           &kp F8           &kp F9        &kp F10       &kp DEL
&rgb_ug RGB_TOG  &trans    &kp UP    &rgb_ug RGB_SAD  &rgb_ug RGB_SAI  &rgb_ug RGB_HUD                            &rgb_ug RGB_HUI  &rgb_ug RGB_BRD  &rgb_ug RGB_BRI  &kp C_BRI_DN  &kp C_BRI_UP  &kp F11
&trans           &kp LEFT  &kp DOWN  &kp RIGHT        &rgb_ug RGB_EFR  &rgb_ug RGB_EFF                            &trans           &trans           &trans           &trans        &kp PG_UP     &kp F12
&trans           &trans    &trans    &bt BT_CLR       &bt BT_PRV       &bt BT_NXT       &out OUT_TOG    &trans    &trans           &trans           &trans           &trans        &kp PG_DN     &trans
                           &trans    &trans           &trans           &trans           &trans          &mkp MB1  &trans           &trans           &trans           &tog 3
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_DN C_VOL_UP &inc_dec_kp PG_UP PG_DN>;
        };
    };
};
